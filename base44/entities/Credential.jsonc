{
  "name": "Credential",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Foreign key to Employee entity"
    },
    "credential_type": {
      "type": "string",
      "description": "Type of credential (license, certification, etc)"
    },
    "credential_name": {
      "type": "string",
      "description": "Name of credential"
    },
    "credential_number": {
      "type": "string",
      "description": "License or credential number"
    },
    "issuing_authority": {
      "type": "string",
      "description": "Organization that issued credential"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "When credential was issued"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "When credential expires"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expiring_soon",
        "expired",
        "suspended",
        "revoked"
      ],
      "default": "active",
      "description": "Credential status"
    },
    "renewal_date": {
      "type": "string",
      "format": "date",
      "description": "When credential needs renewal"
    },
    "document_url": {
      "type": "string",
      "description": "URL to credential document"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "employee_id",
    "credential_type",
    "credential_name"
  ]
}