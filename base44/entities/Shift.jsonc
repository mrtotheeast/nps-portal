{
  "name": "Shift",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Foreign key to Employee entity"
    },
    "site_id": {
      "type": "string",
      "description": "Foreign key to Site entity"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Shift start time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Shift end time"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Shift status"
    },
    "role": {
      "type": "string",
      "description": "Role/position for this shift (e.g. Officer, Supervisor)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the shift"
    },
    "created_by": {
      "type": "string",
      "description": "User ID who created the shift"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the shift was published"
    }
  },
  "required": [
    "employee_id",
    "site_id",
    "start_time",
    "end_time"
  ]
}